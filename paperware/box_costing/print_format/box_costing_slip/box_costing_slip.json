    "module": "Box Costing",
    "name": "Box Costing Slip",
    "owner": "Administrator",
    "print_format_builder": 0,
    "print_format_type": "Jinja",
    "raw_printing": 0,
    "show_section_headings": 0,
    "standard": "Yes",
    "html": "{% set doc = doc %}\n<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<style>\n  body { font-family: Arial, sans-serif; font-size: 12px; color: #1a1a1a; margin: 0; padding: 0; }\n  .slip-wrapper { max-width: 900px; margin: 0 auto; padding: 24px; }\n  .header { text-align: center; border-bottom: 2px solid #333; padding-bottom: 10px; margin-bottom: 12px; }\n  .header h1 { margin: 0 0 2px; font-size: 20px; letter-spacing: 1px; }\n  .header h2 { margin: 0; font-size: 14px; font-weight: normal; color: #555; }\n  .meta-table { width: 100%; border-collapse: collapse; margin-bottom: 14px; }\n  .meta-table td { padding: 4px 8px; font-size: 12px; }\n  .meta-table td:first-child { font-weight: bold; width: 160px; }\n  .two-col { display: table; width: 100%; border-collapse: collapse; margin-bottom: 14px; }\n  .col-left  { display: table-cell; width: 55%; vertical-align: top; padding-right: 10px; }\n  .col-right { display: table-cell; width: 45%; vertical-align: top; padding-left: 10px; border-left: 1px solid #ccc; }\n  .cost-table { width: 100%; border-collapse: collapse; }\n  .cost-table th { background: #f0f0f0; text-align: left; padding: 5px 8px; border: 1px solid #ccc; font-size: 11px; }\n  .cost-table td { padding: 4px 8px; border: 1px solid #ddd; font-size: 12px; }\n  .cost-table tr:nth-child(even) td { background: #fafafa; }\n  .info-box { background: #f8f9fa; border: 1px solid #ddd; border-radius: 4px; padding: 10px 12px; }\n  .info-box table { width: 100%; border-collapse: collapse; }\n  .info-box td { padding: 3px 4px; font-size: 12px; }\n  .info-box td:first-child { font-weight: bold; width: 60%; color: #444; }\n  .info-box td:last-child  { text-align: right; }\n  .footer-summary { width: 100%; border-collapse: collapse; margin-top: 14px; border-top: 2px solid #333; }\n  .footer-summary td { padding: 5px 10px; font-size: 13px; }\n  .footer-summary .label  { font-weight: bold; color: #333; }\n  .footer-summary .value  { text-align: right; font-weight: bold; }\n  .highlight td { background: #1d4ed8; color: #fff; font-size: 14px; }\n  .section-title { font-weight: bold; font-size: 11px; color: #555; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }\n</style>\n</head>\n<body>\n<div class=\"slip-wrapper\">\n\n  <div class=\"header\">\n    <h1>PaperWare Factory</h1>\n    <h2>Box Costing Slip</h2>\n  </div>\n\n  <table class=\"meta-table\">\n    <tr>\n      <td>Client Name</td><td>{{ doc.client_name or \"\\u2014\" }}</td>\n      <td>Costing Date</td><td>{{ frappe.format(doc.costing_date, {\"fieldtype\": \"Date\"}) }}</td>\n    </tr>\n    <tr>\n      <td>Item Code</td><td>{{ doc.item_code }}</td>\n      <td>Item Name</td><td>{{ doc.item_name or \"\\u2014\" }}</td>\n    </tr>\n    <tr>\n      <td>Reference No.</td><td colspan=\"3\">{{ doc.name }}</td>\n    </tr>\n  </table>\n\n  <div class=\"two-col\">\n    <div class=\"col-left\">\n      <div class=\"section-title\">Cost Breakdown</div>\n      <table class=\"cost-table\">\n        <thead>\n          <tr>\n            <th style=\"width:30px\">NO.</th>\n            <th>Description</th>\n            <th style=\"text-align:right\">Total (\\u09f3)</th>\n            <th style=\"width:90px;text-align:center\">Note</th>\n          </tr>\n        </thead>\n        <tbody>\n          {% for idx, row in enumerate(doc.items, 1) %}\n          <tr>\n            <td style=\"text-align:center\">{{ idx }}</td>\n            <td>{{ row.description }}</td>\n            <td style=\"text-align:right\">{{ frappe.format(row.amount, {\"fieldtype\": \"Currency\"}) }}</td>\n            <td style=\"text-align:center; font-size:10px; color:#666\">{{ row.formula_note or \"\" }}</td>\n          </tr>\n          {% endfor %}\n        </tbody>\n      </table>\n    </div>\n\n    <div class=\"col-right\">\n      <div class=\"section-title\">Production Info</div>\n      <div class=\"info-box\">\n        <table>\n          <tr><td>Order Qty</td><td>{{ doc.qty | int }} Pcs</td></tr>\n          <tr><td>Paper Type</td><td>{{ doc.paper_type or \"\\u2014\" }}</td></tr>\n          <tr><td>GSM</td><td>{{ doc.gsm or \"\\u2014\" }}</td></tr>\n          <tr>\n            <td>Cutting Size</td>\n            <td>\n              {%- if doc.cutting_size_w or doc.cutting_size_h or doc.cutting_size_l -%}\n                {{ doc.cutting_size_w or 0 }}\" \\u00d7 {{ doc.cutting_size_h or 0 }}\" \\u00d7 {{ doc.cutting_size_l or 0 }}\"\n              {%- else -%}\\u2014{%- endif -%}\n            </td>\n          </tr>\n          <tr><td>Sheet Size</td><td>{{ doc.sheet_size or \"\\u2014\" }}</td></tr>\n          <tr><td>Paper Rate / Sheet</td><td>\\u09f3 {{ frappe.format(doc.paper_rate_per_sheet, {\"fieldtype\": \"Currency\"}) }}</td></tr>\n          <tr><td>Pcs per Sheet</td><td>{{ doc.pcs_per_sheet or \"\\u2014\" }}</td></tr>\n          <tr><td>Total Sheets</td><td>{{ doc.total_sheets or 0 }}</td></tr>\n          <tr><td>UOM</td><td>{{ doc.uom or \"Nos\" }}</td></tr>\n        </table>\n      </div>\n    </div>\n  </div>\n\n  <table class=\"footer-summary\">\n    <tr>\n      <td class=\"label\">Total Amount</td>\n      <td class=\"value\">\\u09f3 {{ frappe.format(doc.total_amount, {\"fieldtype\": \"Currency\"}) }}</td>\n      <td class=\"label\">Production Rate / Pc</td>\n      <td class=\"value\">\\u09f3 {{ frappe.format(doc.production_rate, {\"fieldtype\": \"Currency\"}) }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">Margin ({{ doc.margin_percent or 0 }}%)</td>\n      <td class=\"value\">\\u09f3 {{ frappe.format(doc.margin_amount, {\"fieldtype\": \"Currency\"}) }} / Pc</td>\n      <td></td><td></td>\n    </tr>\n    <tr class=\"highlight\">\n      <td colspan=\"2\" style=\"font-size:15px;padding:8px 10px\">&#9654; Final Rate per Pc</td>\n      <td colspan=\"2\" style=\"text-align:right;font-size:15px;padding:8px 10px\">\\u09f3 {{ frappe.format(doc.final_rate, {\"fieldtype\": \"Currency\"}) }}</td>\n    </tr>\n  </table>\n\n</div>\n</body>\n</html>"
}
